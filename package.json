{
  "name": "alph-btc-atomic-swap",
  "version": "0.1.0",
  "description": "BTC-ALPH atomic swaps via MuSig2 adaptor signatures - scriptless scripts with taproot key-path spends",
  "type": "module",
  "scripts": {
    "swap": "node src/atomic-swap.js",
    "nostr-swap": "node src/nostr-swap.js",
    "web": "node src/server.js",
    "web:testnet": "SWAP_NETWORK=testnet node src/server.js",
    "wallet": "node src/wallet.js",
    "reset": "rm -rf devnet/bitcoin/regtest devnet/alephium/.alephium .swap-state.json && echo 'Chain data and swap state cleared.'",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "smoke:web": "node scripts/smoke-web.mjs",
    "test:bip327": "node test/bip327.test.mjs",
    "compile:contract": "node scripts/compile-contract.mjs",
    "test:keys": "node test/keys.test.mjs",
    "test:entropy": "node test/entropy.test.mjs",
    "test:fees": "node test/fees.test.mjs",
    "test:adversarial": "node test/adversarial.test.mjs",
    "test:petri": "node test/petri.test.mjs && node scripts/petri-doc.mjs --check",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:live": "node scripts/e2e-web.mjs"
  },
  "keywords": [
    "alephium",
    "bitcoin",
    "atomic-swap",
    "musig2",
    "adaptor-signatures",
    "schnorr",
    "bip340",
    "taproot"
  ],
  "license": "MIT",
  "dependencies": {
    "@alephium/web3": "^2.0.8",
    "@alephium/web3-wallet": "^2.0.8",
    "bitcoinjs-lib": "^7.0.1",
    "ecpair": "^3.0.1",
    "nostr-tools": "^2.23.1",
    "tiny-secp256k1": "^2.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "noble-curves-1": "npm:@noble/curves@^1.9.7",
    "noble-hashes-1": "npm:@noble/hashes@^1.8.0",
    "puppeteer-core": "^24.43.1",
    "qrcode-generator": "^1.4.4"
  }
}
